{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS operator desktop: presence, captions and display cards over the local voice service.",
  "author": "brutalstein",
  "repository": "https://github.com/brutalstein/jarvis216",
  "main": "dist/main.cjs",
  "overrides": {
    "@electron/get": { "global-agent": "4.1.3" }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && playwright test",
    "start": "node build.mjs && electron .",
    "package:win": "node build.mjs && electron-builder --win nsis --x64 --publish never",
    "package:win:test": "npm run package:win -- -c.forceCodeSigning=false"
  },
  "build": {
    "appId": "com.brutalstein.jarvis216",
    "productName": "JARVIS216",
    "forceCodeSigning": true,
    "asar": true,
    "directories": {
      "output": "../../artifacts/desktop-release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "artifactName": "JARVIS216-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "brutalstein",
      "repo": "jarvis216"
    }
  },
  "dependencies": {
    "@pipecat-ai/client-js": "1.14.0",
    "@pipecat-ai/small-webrtc-transport": "1.11.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
