# Generate real local values with scripts/bootstrap.ps1. Never commit .env.
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://jarvis:REPLACE_POSTGRES_PASSWORD@127.0.0.1:55432/jarvis
JARVIS_TOKEN=REPLACE_OPERATOR_TOKEN_WITH_RANDOM_SECRET
N8N_INGRESS_TOKEN=REPLACE_N8N_TOKEN_WITH_DIFFERENT_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_N8N_ENCRYPTION_KEY
BROWSER_WORKER_TOKEN=REPLACE_BROWSER_TOKEN
PORT=2160
WORKER_CONCURRENCY=2
# Workers that only take spoken turns, so conversation never waits behind background work.
INTERACTIVE_CONCURRENCY=2
MODEL_CONCURRENCY=2
BROWSER_CONCURRENCY=1
WORKFLOW_CONCURRENCY=1

ENABLE_DESKTOP=false
WINDOWS_MCP_COMMAND=uvx
WINDOWS_MCP_ARGS=["windows-mcp@0.8.8","serve"]
# JSON array of absolute folders under USERPROFILE; defaults to Desktop, Documents, Downloads.
JARVIS_FILE_ROOTS=
ENABLE_NEWS=false
NEWS_FEEDS=["https://news.google.com/rss?hl=tr&gl=TR&ceid=TR:tr"]

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
# Empty means claude-opus-5-5. Registers "claude" and a low-effort "claude-live" for voice turns.
CLAUDE_MODEL=
# Optional effort for "claude": low, medium, high, xhigh or max (empty = model default).
CLAUDE_EFFORT=
# Server-side refusal fallback on models that accept it; the served model is recorded.
CLAUDE_REFUSAL_FALLBACK=true
ENABLE_CLAUDE_CODE=false
CLAUDE_CODE_PATH=
CLAUDE_CODE_MODEL=
# Separate, tool-using Claude Code agent. Requires the above binary and model.
ENABLE_CLAUDE_AGENT=false
# Absolute path to the delegated project; blank creates data/claude-agent.
CLAUDE_AGENT_WORKSPACE=
# Claude's own permissions: auto, acceptEdits, plan or dontAsk.
CLAUDE_AGENT_PERMISSION_MODE=auto
CLAUDE_AGENT_MAX_TURNS=12
# Optional absolute private JSON file with MCP servers.
CLAUDE_AGENT_MCP_CONFIG=
ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional semantic recall for the learning brain: "gemini" (needs ENABLE_GEMINI) or empty.
BRAIN_EMBEDDINGS=
BRAIN_EMBEDDING_MODEL=
# Providers that may receive private data without per-action approval (comma list of ids).
JARVIS_PRIVATE_PROVIDERS=claude-code
ENABLE_OPENROUTER=false
OPENROUTER_API_KEY=
# Comma list of OpenRouter model ids, e.g. vendor/model:free. Re-probe before relying on them.
OPENROUTER_MODELS=
ENABLE_NVIDIA=false
NVIDIA_API_KEY=
NVIDIA_MODELS=
# Optional rolling 24-hour ceilings per provider id; a spent budget skips that provider, e.g.
# {"or-model-name":{"callsPerDay":45},"claude":{"tokensPerDay":500000}}
PROVIDER_BUDGETS_JSON={}

ENABLE_OPENCLAW=false
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_AGENT_ID=jarvis-reader
OPENCLAW_TOKEN=
OPENCLAW_POLICY_VERIFIED=false

ENABLE_BROWSER=false
BROWSER_WORKER_URL=http://127.0.0.1:8765
BROWSER_EGRESS_VERIFIED=false
BROWSER_ALLOWED_URLS=["https://example.com/"]

ENABLE_N8N=false
N8N_WORKFLOWS_JSON={}
# Optional push of n8n-submitted task outcomes (examples/n8n/jarvis-task-events.json); set both.
N8N_CALLBACK_URL=
N8N_CALLBACK_TOKEN=

ENABLE_CODEX=false
CODEX_AUTH=api-key
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_ISOLATION_VERIFIED=false
CODEX_WORKSPACE=
CODEX_ISOLATED_HOME=
