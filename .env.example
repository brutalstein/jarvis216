# Generate real local values with scripts/bootstrap.ps1. Never commit .env.
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://jarvis:REPLACE_POSTGRES_PASSWORD@127.0.0.1:55432/jarvis
JARVIS_TOKEN=REPLACE_OPERATOR_TOKEN_WITH_RANDOM_SECRET
N8N_INGRESS_TOKEN=REPLACE_N8N_TOKEN_WITH_DIFFERENT_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_N8N_ENCRYPTION_KEY
BROWSER_WORKER_TOKEN=REPLACE_BROWSER_TOKEN
PORT=2160
WORKER_CONCURRENCY=1
MODEL_CONCURRENCY=2
BROWSER_CONCURRENCY=1
WORKFLOW_CONCURRENCY=1

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ENABLE_CLAUDE_CODE=false
CLAUDE_CODE_PATH=
CLAUDE_CODE_MODEL=
ENABLE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=

ENABLE_OPENCLAW=false
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_AGENT_ID=jarvis-reader
OPENCLAW_TOKEN=
OPENCLAW_POLICY_VERIFIED=false

ENABLE_BROWSER=false
BROWSER_WORKER_URL=http://127.0.0.1:8765
BROWSER_EGRESS_VERIFIED=false
BROWSER_ALLOWED_URLS=["https://example.com/"]

ENABLE_N8N=false
N8N_WORKFLOWS_JSON={}

ENABLE_CODEX=false
CODEX_AUTH=api-key
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_ISOLATION_VERIFIED=false
CODEX_WORKSPACE=
CODEX_ISOLATED_HOME=
