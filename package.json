{
  "name": "jarvis-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @jarvis/integration-hub && npm run build -w @jarvis/action-engine && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts packages/action-engine/src packages/action-engine/tests apps/desktop/src apps/desktop/tests packages/integration-hub/src packages/integration-hub/tests",
    "format": "biome check --write src tests scripts packages/action-engine/src packages/action-engine/tests",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.live.test.ts",
    "start": "node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env --conditions=jarvis-source --import tsx src/main.ts",
    "cli": "node --env-file=.env --conditions=jarvis-source --import tsx src/cli.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "benchmark": "tsx scripts/benchmark.ts",
    "contracts": "tsx scripts/export-contracts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google/genai": "2.30.0",
    "@jarvis/action-engine": "0.1.0",
    "@jarvis/integration-hub": "0.1.0",
    "@openai/codex-sdk": "0.163.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
