{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": ".", "types": ["node"],
    "customConditions": ["jarvis-source"]
  },
  "include": [
    "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts",
    "packages/*/src/**/*.ts", "packages/*/tests/**/*.ts"
  ]
}
